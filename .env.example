# Where the HRMS backend lives. The scheme listings on /fisheries and the other
# service pages are fetched from its /api/public/schemes endpoint at runtime.
#
# Left unset, the site falls back to http://localhost:5000, which is right for
# local development and wrong everywhere else.
#
# NEXT_PUBLIC_ is required: this is read in the browser, not on the server.
#
# In production this is the deployed HRMS API:
#   NEXT_PUBLIC_HRMS_API_URL=https://backend.matrubhumi.net
#
# The backend must also allow this site's origin. It already permits
# http://localhost:3000; for any other host add it there:
#   EXTRA_ALLOWED_ORIGINS=https://matrubhoomifarms.com
NEXT_PUBLIC_HRMS_API_URL=http://localhost:5000
